# Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env. These are placeholders only.

PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=daisy15
DB_NAME=disaster_resource_mgmt

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Public URL of the React frontend. Used for CORS/Socket.io AND for the link
# inside password-reset emails (<CLIENT_URL>/reset-password?token=...).
#   local : http://localhost:3000
#   AWS   : https://your-domain.com   (or http://<ec2-public-ip>)
CLIENT_URL=http://localhost:3000

# Email (Gmail SMTP — use an App Password, NOT your real Gmail password)
# Google Account → Security → 2-Step Verification → App Passwords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM=DisasterRM <your_gmail_address@gmail.com>

# Optional: separate secret used to HMAC email-verification OTPs.
# Falls back to JWT_SECRET when unset.
# EMAIL_OTP_SECRET=replace_with_another_long_random_string

# Optional: set when running behind nginx / an AWS load balancer so per-IP
# rate limiting sees the real client IP (e.g. 1 = one proxy hop).
# TRUST_PROXY=1
